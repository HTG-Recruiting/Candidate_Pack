<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#140B30" />
  <title>Candidate Pack · HomeToGo Group</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />
  <style>
    :root {
      --bg-stage: #140B30;
      --purple-deep: #1E1047;
      --purple-main: #4D21B5;
      --lavender-bg: #F4F1FC;
      --light-bg: #FFFFFF;
      --ink: #171326;
      --ink-muted: #5A5470;
      --accent-grad: linear-gradient(90deg, #FF5A5F 0%, #8A4FFF 50%, #00A896 100%);
      --brand-color: #4D21B5;
      --radius-page: 24px;
      --radius-card: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at top, #28165C 0%, var(--bg-stage) 75%);
      color: var(--ink);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, .eyebrow, .stat b {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Topbar */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 24px;
      color: #fff;
      max-width: 620px;
      width: 100%;
      margin: 0 auto;
    }

    .brand-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: -0.02em;
    }

    .brand-title .muted {
      font-weight: 500;
      opacity: 0.72;
      padding-left: 10px;
      border-left: 1px solid rgba(255,255,255,0.25);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .company-select {
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.25);
      color: #fff;
      padding: 6px 12px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      outline: none;
    }
    .company-select option { color: var(--ink); background: #fff; }

    .counter {
      font-size: 0.82rem;
      font-weight: 600;
      opacity: 0.8;
      min-width: 44px;
      text-align: right;
    }

    /* Stage & Book */
    .stage {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px 16px;
    }

    .book {
      width: 100%;
      max-width: 460px;
      height: min(780px, 78dvh);
      position: relative;
      border-radius: var(--radius-page);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.45);
      overflow: hidden;
      background: var(--light-bg);
    }

    .page {
      position: absolute;
      inset: 0;
      display: none;
      flex-direction: column;
      padding: 28px 26px 20px;
      overflow-y: auto;
      animation: pageEnter 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .page.active { display: flex; }

    @keyframes pageEnter {
      from { opacity: 0; transform: translateX(18px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .tone-dark {
      background: linear-gradient(155deg, #1E1047 0%, var(--brand-color) 100%);
      color: #fff;
      justify-content: space-between;
    }

    .tone-light { background: #FFFFFF; color: var(--ink); }
    .tone-lav { background: var(--lavender-bg); color: var(--ink); }

    /* Typography & Common Blocks */
    .eyebrow {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--brand-color);
      margin-bottom: 6px;
    }
    .eyebrow.on-dark { color: rgba(255,255,255,0.75); }

    .pg-head { margin-bottom: 18px; }
    .pg-head h2 {
      font-size: 1.55rem;
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.02em;
    }

    .cover-body { margin-top: auto; }
    .cover-body h1 {
      font-size: 2.15rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 14px;
    }
    .cover-body .lead {
      font-size: 1rem;
      line-height: 1.5;
      color: rgba(255,255,255,0.86);
      margin-bottom: 28px;
    }

    .grad-bar {
      display: block;
      height: 5px;
      width: 100%;
      border-radius: 999px;
      background: var(--accent-grad);
      margin-bottom: 12px;
    }

    .hint {
      font-size: 0.82rem;
      font-weight: 600;
      opacity: 0.85;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Cards & Grids */
    .card {
      background: #fff;
      border-radius: var(--radius-card);
      padding: 16px 18px;
      margin-bottom: 12px;
      border: 1px solid rgba(23, 19, 38, 0.08);
    }
    .tone-light .card { background: #F8F7FC; }

    .card.dark {
      background: #1B113A;
      color: #fff;
      border: none;
    }

    .card .label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.7;
      margin-bottom: 4px;
    }

    .card h3 { font-size: 1.12rem; margin-bottom: 6px; }
    .card p { font-size: 0.88rem; line-height: 1.45; opacity: 0.9; }

    .stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 16px;
    }
    .stat {
      background: #F4F1FC;
      padding: 12px 14px;
      border-radius: 14px;
    }
    .stat b { display: block; font-size: 1.35rem; color: var(--brand-color); }
    .stat span { font-size: 0.78rem; color: var(--ink-muted); line-height: 1.3; display: block; }

    .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 10px; }
    .chip {
      font-size: 0.76rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      background: #EFEAFB;
      color: var(--purple-main);
    }
    .chip.on-dark { background: rgba(255,255,255,0.16); color: #fff; }

    /* Leadership Principles */
    .lp-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .lp-list li {
      background: #fff;
      padding: 10px 14px;
      border-radius: 12px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .lp-num {
      font-weight: 800;
      font-size: 0.78rem;
      color: var(--brand-color);
      background: #EFEAFB;
      padding: 3px 7px;
      border-radius: 6px;
      margin-top: 2px;
    }
    .lp-list h3 { font-size: 0.92rem; margin-bottom: 1px; }
    .lp-list p { font-size: 0.8rem; color: var(--ink-muted); }

    /* Steps */
    .steps { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
    .step { display: flex; gap: 12px; align-items: flex-start; font-size: 0.86rem; }
    .marker {
      width: 24px; height: 24px; border-radius: 50%;
      background: #E7E3F3; color: var(--ink);
      font-weight: 700; font-size: 0.76rem;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .step.done .marker { background: #00A896; color: #fff; }
    .step.now .marker { background: var(--brand-color); color: #fff; }
    .step b { display: block; font-size: 0.9rem; }
    .step span { color: var(--ink-muted); font-size: 0.8rem; }

    /* Tiles */
    .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .tile {
      background: #F7F6FB;
      padding: 12px;
      border-radius: 14px;
    }
    .tile h3 { font-size: 0.9rem; margin-bottom: 3px; }
    .tile p { font-size: 0.78rem; color: var(--ink-muted); line-height: 1.38; }

    /* Facts */
    .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 0.84rem; margin-top: 10px; }
    .facts dt { opacity: 0.7; font-weight: 600; }
    .facts dd { font-weight: 600; }

    /* Folio */
    .folio {
      margin-top: auto;
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      font-size: 0.74rem;
      color: var(--ink-muted);
      font-weight: 600;
    }

    /* Controls */
    .controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 12px 16px 20px;
    }
    .nav-btn {
      width: 38px; height: 38px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.22);
      background: rgba(255,255,255,0.1);
      color: #fff; font-size: 1.1rem; cursor: pointer;
    }
    .nav-btn:disabled { opacity: 0.3; cursor: default; }
    .dots { display: flex; gap: 6px; }
    .dot {
      width: 8px; height: 8px; border-radius: 999px;
      border: none; background: rgba(255,255,255,0.3);
      cursor: pointer; transition: all 0.2s;
    }
    .dot.on { width: 22px; background: #fff; }
  </style>
</head>
