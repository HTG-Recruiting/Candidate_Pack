        ]
      },
      interhome: {
        name: "Interhome",
        color: "#005596",
        p6Title: "Interhome, Zurich & Local Hubs",
        p6Desc: "Europe’s leading full-service holiday home specialist with 60+ years of hospitality heritage across 120+ local destination offices.",
        p6Office: "Glattbrugg (Zurich) & Destinations",
        p6Lang: "English, German & Local",
        p9Try: "Browse Interhome.com and explore how owners and guests experience full-service holiday homes.",
        tiles: [
          { h: "Hybrid & local", p: "Flexible hybrid setup in HQ paired with hands-on destination teams." },
          { h: "Holiday perks", p: "Generous employee discounts on 70,000+ Interhome properties." },
          { h: "Swiss & EU standards", p: "Competitive compensation, pension plans, and social benefits." },
          { h: "AI & digital tools", p: "Modern cloud workspace and Group-wide AI productivity tools." },
          { h: "Cross-Group mobility", p: "Career pathways across Interhome, HomeToGo, and Smoobu." },
          { h: "Learning & growth", p: "Language courses, hospitality training, and leadership programs." },
          { h: "Commuter support", p: "Public transport subsidies and modern office facilities." },
