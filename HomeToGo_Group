        ]
      },
      smoobu: {
        name: "Smoobu",
        color: "#00877A",
        p6Title: "Smoobu, Berlin",
        p6Desc: "The all-in-one vacation rental SaaS empowering independent hosts and property managers to automate bookings and sync channels.",
        p6Office: "Berlin & Hybrid",
        p6Lang: "English (plus multi-market)",
        p9Try: "Explore Smoobu.com or test a free trial to see how hosts manage calendars and direct bookings.",
        tiles: [
          { h: "SaaS agility", p: "Fast-moving product & customer teams with high individual ownership." },
          { h: "Flexible hybrid", p: "Hybrid work from our Berlin hub plus workation options abroad." },
          { h: "Time off", p: "Generous annual vacation allowance growing with your tenure." },
          { h: "AI-first workflow", p: "Full access to modern AI coding, support, and productivity tools." },
          { h: "Learning budget", p: "Dedicated resources for SaaS conferences, courses, and languages." },
          { h: "Wellbeing", p: "Subsidized sports memberships and mental health resources." },
          { h: "Getting around", p: "Deutschland-Ticket subsidy and bike leasing options." },
          { h: "Travel discounts", p: "Exclusive employee stay discounts across HomeToGo Group." }
        ]
      }
    };

    const pages = Array.from(document.querySelectorAll('.page'));
    const dotsWrap = document.getElementById('dots');
    const counter = document.getElementById('counter');
    const prevBtn = document.getElementById('prev');
    const nextBtn = document.getElementById('next');
    const companySwitch = document.getElementById('companySwitch');
    let current = 0;

    // Build dots
    pages.forEach((_, idx) => {
      const d = document.createElement('button');
      d.className = 'dot' + (idx === 0 ? ' on' : '');
      d.setAttribute('aria-label', `Go to page ${idx + 1}`);
      d.onclick = () => goTo(idx);
      dotsWrap.appendChild(d);
    });

    function goTo(idx) {
      current = Math.max(0, Math.min(pages.length - 1, idx));
      pages.forEach((p, i) => p.classList.toggle('active', i === current));
      Array.from(dotsWrap.children).forEach((d, i) => d.classList.toggle('on', i === current));
      counter.textContent = `${current + 1} / ${pages.length}`;
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === pages.length - 1;
    }

    function applyCompany(key) {
      const c = COMPANIES[key] || COMPANIES.hometogo;
      document.documentElement.style.setProperty('--brand-color', c.color);
      document.title = `Candidate Pack · ${c.name}`;
      document.getElementById('brandLabel').textContent = c.name;
      document.getElementById('coverLogo').textContent = c.name;
      document.getElementById('closeLogo').textContent = c.name;
      document.getElementById('coverEyebrow').textContent = `Candidate pack · ${c.name}`;
      document.getElementById('p6Eyebrow').textContent = `Where you’d work · ${c.name}`;
      document.getElementById('p6Title').textContent = c.p6Title;
      document.getElementById('p6Desc').textContent = c.p6Desc;
      document.getElementById('p6Office').textContent = c.p6Office;
      document.getElementById('p6Lang').textContent = c.p6Lang;
      document.getElementById('p9Try').textContent = c.p9Try;
      document.getElementById('p10Eyebrow').textContent = `What we offer · ${c.name}`;
      document.getElementById('p10Title').textContent = `Life at ${c.name}`;

      document.querySelectorAll('.folio-brand').forEach(el => {
        el.textContent = `HomeToGo Group · ${c.name}`;
      });

      const tilesEl = document.getElementById('p10Tiles');
      tilesEl.innerHTML = c.tiles.map(t => `<div class="tile"><h3>${t.h}</h3><p>${t.p}</p></div>`).join('');

      companySwitch.value = key;
      if (window.location.hash !== `#${key}`) {
        history.replaceState(null, '', `#${key}`);
      }
    }

    prevBtn.onclick = () => goTo(current - 1);
    nextBtn.onclick = () => goTo(current + 1);
    companySwitch.onchange = (e) => applyCompany(e.target.value);

    // Keyboard & Touch Swipe Support
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo(current + 1);
      if (e.key === 'ArrowLeft') goTo(current - 1);
    });

    let touchStartX = 0;
    const book = document.getElementById('book');
    book.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    book.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 45) goTo(current + (diff > 0 ? 1 : -1));
    }, { passive: true });

    // Initialize from URL hash (#hometogo, #interhome, #smoobu)
    const initialHash = window.location.hash.replace('#', '').toLowerCase();
    applyCompany(COMPANIES[initialHash] ? initialHash : 'hometogo');
    goTo(0);
  </script>
</body>
